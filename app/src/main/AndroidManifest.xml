<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- PDF picking uses SAF (OpenDocument), which needs no storage permission.
         Strip the legacy storage permission and the media permissions AGP
         auto-merges from it, so the Play Console doesn't ask us to justify
         access we don't use. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"
        tools:node="remove" />

    <!-- Required to keep on-device LLM inference, model downloads, and document indexing alive when the user switches to another app -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Required on Android 13+ to show the foreground service notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Prevents CPU from throttling mid-inference when screen turns off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".AnvitApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/Theme.Anvit">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Anvit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service that keeps on-device LLM inference alive when the user switches apps -->
        <service
            android:name=".inference.InferenceForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device large language model inference that must continue running while the user interacts with other apps to avoid losing in-progress AI responses." />
        </service>

        <!-- Foreground service that keeps multi-GB model downloads (Gemma 4, embedding models) running when the user switches apps -->
        <service
            android:name=".download.DownloadForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Foreground service that keeps PDF ingestion (extract, chunk, embed, index) running when the user switches apps -->
        <service
            android:name=".document.IngestionForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device document indexing that runs hundreds of embedding-model inference calls per document and must continue when the user interacts with other apps to avoid leaving documents half-indexed." />
        </service>

    </application>

</manifest>
